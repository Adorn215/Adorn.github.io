<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Adorn Boutique Shop</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background-color: #ffe6f0;
      color: #333;
    }
    header {
      background-color: #ff99cc;
      padding: 20px;
      text-align: center;
      color: white;
    }
    nav {
      display: flex;
      justify-content: center;
      background-color: #ffb6d9;
      padding: 10px;
    }
    nav a {
      margin: 0 15px;
      color: white;
      text-decoration: none;
      font-weight: bold;
    }
    .section {
      padding: 40px;
      text-align: center;
    }
    .gallery {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
    }
    .gallery img {
      width: 200px;
      height: 250px;
      object-fit: cover;
      border: 3px solid #ff99cc;
      border-radius: 10px;
    }
    form {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    input, textarea {
      width: 300px;
      padding: 10px;
      border: 2px solid #ff99cc;
      border-radius: 5px;
    }
    button {
      background-color: #ff99cc;
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
    footer {
      text-align: center;
      padding: 20px;
      background-color: #ffb6d9;
      color: white;
    }
  </style>
</head>
<body>
  <header>
    <h1>Adorn Boutique Shop</h1>
    <p>Find your perfect style</p>
  </header>
  <nav>
    <a href="#home">Home</a>
    <a href="#gallery">Gallery</a>
    <a href="#contact">Contact</a>
  </nav>
  <section class="section" id="home">
    <h2>Welcome to Adorn Boutique</h2>
    <p>Discover unique and beautiful fashion pieces curated just for you.</p>
  </section>
  <section class="section" id="gallery">
    <h2>Our Collection</h2>
    <div class="gallery">
      <img src="https://via.placeholder.com/200x250?text=Item+1" alt="Item 1">
      <img src="https://via.placeholder.com/200x250?text=Item+2" alt="Item 2">
      <img src="https://via.placeholder.com/200x250?text=Item+3" alt="Item 3">
      <img src="https://via.placeholder.com/200x250?text=Item+4" alt="Item 4">
    </div>
  </section>
  <section class="section" id="contact">
    <h2>Contact Us</h2>
    <form action="#" method="post">
      <input type="text" name="name" placeholder="Your Name" required>
      <input type="email" name="email" placeholder="Your Email" required>
      <textarea name="message" rows="5" placeholder="Your Message" required></textarea>
      <button type="submit">Send Message</button>
    </form>
  </section>
  <footer>
    <p>&copy; 2025 Adorn Boutique Shop. All rights reserved.</p>
  </footer>
</body>
</html>
